{
  "name": "set-notifications",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://royalkabro.github.io"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PUSH",
        "class_name": "PushScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "PushScheduler"
      ]
    }
  ]
}
